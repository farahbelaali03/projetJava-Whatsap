<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.ChatController"
      prefWidth="1000" prefHeight="640"
      style="-fx-background-color: #111B21;">


    <VBox prefWidth="320" maxWidth="320"
          style="-fx-background-color: #111B21;">

        <!-- En-tête -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: #202C33;">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="WhatsApp"
                   style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#E9EDEF;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelNomUtilisateur"
                   style="-fx-text-fill:#25D366; -fx-font-size:13px;"/>
            <Button text="⏻" onAction="#seDeconnecter"
                    style="-fx-background-color:transparent; -fx-text-fill:#8696A0;
                           -fx-font-size:16px; -fx-cursor:hand;">
                <tooltip><Tooltip text="Se déconnecter"/></tooltip>
            </Button>
        </HBox>


        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color:#111B21; -fx-tab-min-width:130px;">


            <Tab text="💬 Contacts">
                <VBox style="-fx-background-color:#111B21;">
                    <Label text="CONTACTS"
                           style="-fx-font-size:11px; -fx-font-weight:bold;
                                  -fx-text-fill:#8696A0; -fx-padding:8px 16px 4px 16px;"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color:#111B21; -fx-background:#111B21;">
                        <VBox fx:id="listeContacts"
                              style="-fx-background-color:#111B21;"/>
                    </ScrollPane>
                </VBox>
            </Tab>


            <Tab text="👥 Groupes">
                <VBox style="-fx-background-color:#111B21;">
                    <Label text="GROUPES"
                           style="-fx-font-size:11px; -fx-font-weight:bold;
                                  -fx-text-fill:#8696A0; -fx-padding:8px 16px 4px 16px;"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color:#111B21; -fx-background:#111B21;">
                        <VBox fx:id="listeGroupes"
                              style="-fx-background-color:#111B21;"/>
                    </ScrollPane>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>


    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #0B141A;">


        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:#202C33;">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>

            <VBox spacing="2">
                <Label fx:id="labelContactActif"
                       text="Sélectionnez un contact ou un groupe"
                       style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#E9EDEF;"/>
                <Label fx:id="labelStatutContact" text=""
                       style="-fx-font-size:12px; -fx-text-fill:#8696A0;"/>
                <Label fx:id="labelGroupeActif" text=""
                       style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#E9EDEF;"/>
                <Label fx:id="labelMembresGroupe" text=""
                       style="-fx-font-size:11px; -fx-text-fill:#8696A0;"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>


            <Button fx:id="boutonAppelAudio"
                    text="📞 Appel audio"
                    onAction="#lancerAppelAudio"
                    disable="true"
                    style="-fx-background-color:transparent; -fx-text-fill:#8696A0;
                           -fx-font-size:12px; -fx-cursor:hand;">
                <tooltip><Tooltip text="Démarrer un appel audio"/></tooltip>
            </Button>


            <Button fx:id="boutonAppelVideo"
                    text="📹 Appel vidéo"
                    onAction="#lancerAppelVideo"
                    disable="true"
                    style="-fx-background-color:transparent; -fx-text-fill:#8696A0;
                           -fx-font-size:12px; -fx-cursor:hand;">
                <tooltip><Tooltip text="Démarrer un appel vidéo"/></tooltip>
            </Button>


            <Button text="🎙 Réunion"
                    onAction="#lancerReunionGroupe"
                    style="-fx-background-color:transparent; -fx-text-fill:#8696A0;
                           -fx-font-size:12px; -fx-cursor:hand;">
                <tooltip><Tooltip text="Démarrer une réunion de groupe"/></tooltip>
            </Button>
        </HBox>


        <ScrollPane fx:id="scrollMessages" fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color:#0B141A; -fx-background:#0B141A;">
            <VBox fx:id="zoneMessages" spacing="4"
                  style="-fx-background-color:#0B141A;">
                <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            </VBox>
        </ScrollPane>


        <ScrollPane fx:id="scrollMessagesGroupe" fitToWidth="true"
                    managed="false" visible="false"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color:#0B141A; -fx-background:#0B141A;">
            <VBox fx:id="zoneMessagesGroupe" spacing="4"
                  style="-fx-background-color:#0B141A;">
                <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            </VBox>
        </ScrollPane>


        <HBox alignment="CENTER" spacing="8"
              style="-fx-background-color:#202C33;">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>

            <Button fx:id="boutonFichier" text="📎" onAction="#envoyerFichier"
                    disable="true"
                    style="-fx-background-color:transparent; -fx-font-size:18px; -fx-cursor:hand;">
                <tooltip><Tooltip text="Envoyer un fichier"/></tooltip>
            </Button>

            <TextField fx:id="champMessage" promptText="Saisir un message..."
                       HBox.hgrow="ALWAYS" disable="true"
                       style="-fx-background-color:#2A3942; -fx-text-fill:#E9EDEF;
                              -fx-prompt-text-fill:#667781; -fx-background-radius:10px;
                              -fx-padding:9px 14px; -fx-font-size:13px;"/>

            <Button fx:id="boutonEnvoyer" text="➤" onAction="#envoyerMessage"
                    disable="true"
                    style="-fx-background-color:#25D366; -fx-text-fill:white;
                           -fx-font-size:14px; -fx-background-radius:20px;
                           -fx-min-width:40px; -fx-min-height:40px; -fx-cursor:hand;"/>
        </HBox>


        <HBox alignment="CENTER" spacing="8"
              managed="false" visible="false"
              style="-fx-background-color:#1A2630;">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>

            <TextField fx:id="champMessageGroupe"
                       promptText="Message au groupe..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#2A3942; -fx-text-fill:#E9EDEF;
                              -fx-prompt-text-fill:#667781; -fx-background-radius:10px;
                              -fx-padding:9px 14px; -fx-font-size:13px;"/>

            <Button text="➤" onAction="#envoyerMessageGroupe"
                    style="-fx-background-color:#7B2D8B; -fx-text-fill:white;
                           -fx-font-size:14px; -fx-background-radius:20px;
                           -fx-min-width:40px; -fx-min-height:40px; -fx-cursor:hand;"/>
        </HBox>

    </VBox>
</HBox>
